{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kubohiroya/turbowarp-openai-realtime-api/main/schemas/extension-manifest.schema.json",
  "title": "TurboWarp Extension API Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "blocks", "menus"],
  "properties": {
    "formatVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+$"},
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["opcode", "blockType", "arguments"],
        "properties": {
          "opcode": {"type": "string", "minLength": 1},
          "blockType": {"type": "string", "minLength": 1},
          "arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1},
                "menu": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "menus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "acceptReporters"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "acceptReporters": {"type": "boolean"}
        }
      }
    }
  }
}
